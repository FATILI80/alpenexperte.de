# Standardmaessig Zeilenenden normalisieren
* text=auto eol=lf

# Windows-Skripte behalten CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Bilder werden als echte Binaerdateien in Git gespeichert (Vercel kann Git LFS NICHT aufloesen)
*.jpg  -text
*.jpeg -text
*.png  -text
*.gif  -text
*.webp -text
*.avif -text
*.bmp  -text
*.tif  -text
*.tiff -text

# Textdateien
*.svg  text
*.html text
*.css  text
*.js   text
*.mp4  -text
*.mov  -text
*.woff  -text
*.woff2 -text
*.ttf   -text
